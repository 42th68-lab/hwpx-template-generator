# 선택 설정: 이 파일을 .env로 복사한 뒤 키를 입력하고 npm start를 다시 실행합니다.
# 키가 없으면 명시적인 문서 조건을 로컬에서 읽는 기본 분석을 사용합니다.
# API 키를 app.js 또는 index.html에 넣거나 GitHub에 올리지 마세요.
GEMINI_API_KEY=
# 구조화된 JSON 출력을 지원하고 본인 API 계정에서 사용할 수 있는 모델을 지정합니다.
GEMINI_MODEL=gemini-3.5-flash-lite
# 선택: 공개 양식 공유 저장소. 로그인이나 회원가입에는 사용하지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
